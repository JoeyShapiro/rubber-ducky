<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="rubber-ducky"
        Arguments=""
        InstallLocation="C:\Program Files\JoeyShpairo\Rubber Ducky">
    </Installer>
    <PackageInformation
        PackageName="Rubber Ducky"
        PackageDisplayName="Rubber Ducky"
        PublisherName="CN=JoeyShpairo"
        PublisherDisplayName="JoeyShpairo"
        Version="0.1.0.0"
        PackageDescription="Native shell for the rubber-ducky web app">
        <Capabilities>
            <Capability Name="runFullTrust" />

        </Capabilities>
        <Applications>
            <Application
                Id="com.joeshapiro.rubber-ducky"
                Description="Native shell for the rubber-ducky web app"
                DisplayName="Rubber Ducky"
                ExecutableName="rubber-ducky"
                EntryPoint="Windows.FullTrustApplication">

            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Rubber Ducky</DisplayName>
            <PublisherDisplayName>JoeyShpairo</PublisherDisplayName>
            <Description>Native shell for the rubber-ducky web app</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="rubber-ducky.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
